# Copy to .env and enter real values. Never commit .env.
DEEPSEEK_API_KEY=replace-with-your-key
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Raw OpenAlex key only; do not include a Bearer prefix.
OPENALEX_API_KEY=

# Reserved for a future IEEE Xplore re-enable; the source is currently disabled.
IEEE_API_KEY=

# Optional: increases GitHub repository-search quota for paper reproduction.
# The system only reads public repository metadata and never executes repository code.
GITHUB_TOKEN=

# Docker host port (bound to 127.0.0.1 by default).
UI_PORT=7860
PYTHON_IMAGE=python:3.11-slim

# FastAPI phase two: protect /api/v1/* with X-API-Key or Authorization: Bearer.
# Keep REQUIRED=0 only for local development. Public deployments must set a
# long random token and API_AUTH_REQUIRED=1.
API_AUTH_TOKEN=
API_AUTH_REQUIRED=0
