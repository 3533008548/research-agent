# 复制为 .env 后填写实际值；不要把 .env 提交到 Git。
DEEPSEEK_API_KEY=replace-with-your-key
# 可选：仅用于 DeepSeek 兼容网关或本地测试，默认官方 API 地址。
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
GLM_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAlex 使用原始 API Key，不要添加 "Bearer " 前缀。Docker Compose 会从 .env 注入该变量。
OPENALEX_API_KEY=

# Docker Compose 宿主机访问端口，可改为例如 8080。
UI_PORT=7860

# Docker Hub 无法连接时，替换为你当前网络可访问的镜像仓库地址。
PYTHON_IMAGE=python:3.11-slim
