{
  "name": "research-assistant-desktop",
  "version": "0.2.3",
  "private": true,
  "description": "科研助手桌面客户端",
  "author": "Research Assistant",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --publish never",
    "test": "node --test tests/*.test.cjs",
    "postinstall": "install-electron"
  },
  "build": {
    "appId": "org.researchassistant.desktop",
    "productName": "Research Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "startup.html",
      "package.json",
      "icon.png",
      "tray.png",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../build/desktop-backend/research-backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "allowElevation": false
    },
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Research-Assistant-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "3533008548",
      "repo": "research-agent",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
